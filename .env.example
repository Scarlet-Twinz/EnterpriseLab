# LOCAL TEST VALUES ONLY. Replace before use; never use these values in production.
LAB_API_KEYS={"local-lab-key-a":{"tenant_id":"tenant_a","role":"admin"},"local-lab-key-b":{"tenant_id":"tenant_b","role":"admin"},"local-lab-key-c":{"tenant_id":"tenant_c","role":"viewer"}}
PROXIMA_SIGNING_KEY=local-only-change-this-signing-secret-to-a-random-32-byte-or-longer-value
PROXIMA_TOKEN_TTL_SECONDS=300

# MUST point to the Proxima Engine listener, never directly to the upstream database.
PROXIMA_DATABASE_URL=postgresql://proxima_app:replace-me@127.0.0.1:6432/enterprise_lab

# Administrative bootstrap only. Do not use this for application requests.
LAB_ADMIN_DATABASE_URL=postgresql://lab_admin:replace-me@127.0.0.1:5432/enterprise_lab

LAB_BASE_URL=http://127.0.0.1:8088
LAB_API_KEY_A=local-lab-key-a
LAB_API_KEY_B=local-lab-key-b
