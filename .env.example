# LOCAL TEST VALUES ONLY. Replace before use; never use these values in production.
LAB_API_KEYS={"local-lab-key-a":{"tenant_id":"tenant_a","role":"admin"},"local-lab-key-b":{"tenant_id":"tenant_b","role":"admin"},"local-lab-key-c":{"tenant_id":"tenant_c","role":"viewer"}}
PROXIMA_TENANT_SIGNING_KEY=local-only-change-this-signing-secret-to-a-random-32-byte-or-longer-value
PROXIMA_TOKEN_TTL_SECONDS=300

# Local disposable database only. Use strong unique values for your own environment.
LAB_POSTGRES_ADMIN_PASSWORD=local-only-change-this-admin-password
LAB_TENANT_A_DB_PASSWORD=local-only-change-this-tenant-a-password
LAB_TENANT_B_DB_PASSWORD=local-only-change-this-tenant-b-password
LAB_TENANT_C_DB_PASSWORD=local-only-change-this-tenant-c-password
LAB_TENANT_DB_PASSWORDS={"tenant_a":"local-only-change-this-tenant-a-password","tenant_b":"local-only-change-this-tenant-b-password","tenant_c":"local-only-change-this-tenant-c-password"}

# MUST point to the Proxima Engine listener, never directly to the upstream database.
# Local loopback only: TLS is disabled in the local Engine launcher.
PROXIMA_DATABASE_URL=postgresql://proxima@127.0.0.1:6432/enterprise_lab?sslmode=disable

# Administrative bootstrap only. Do not use this for application requests.
LAB_ADMIN_DATABASE_URL=postgresql://lab_admin:local-only-change-this-admin-password@127.0.0.1:55432/enterprise_lab

LAB_BASE_URL=http://127.0.0.1:8088
LAB_API_KEY_A=local-lab-key-a
LAB_API_KEY_B=local-lab-key-b
LAB_API_KEY_C=local-lab-key-c


# Optional read-only Control Plane acceptance; fill only for your dedicated test account.
AGATA_CONTROL_PLANE_URL=http://127.0.0.1:8080
AGATA_LAB_EMAIL=
AGATA_LAB_PASSWORD=
AGATA_PROXIMA_COMMIT=
